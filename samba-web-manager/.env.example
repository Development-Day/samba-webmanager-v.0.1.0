# ============================================================
# Samba Web Manager - образец конфигурации
# ============================================================
# Скопируйте в .env и заполните:
#   cp .env.example .env
#
# Сгенерировать SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
FLASK_ENV=production
PORT=5000

# ------------------------------------------------------------
# Администратор веб-интерфейса
# ------------------------------------------------------------
ADMIN_USERNAME=admin
# ОБЯЗАТЕЛЬНО смените! Минимум 12 символов, буквы+цифры+символы
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
# Альтернатива: bcrypt-хеш вместо пароля
# ADMIN_PASSWORD_HASH=$2b$12$...

# ------------------------------------------------------------
# Samba
# ------------------------------------------------------------
SAMBA_CONFIG=/etc/samba/smb.conf
SAMBA_PASSWD=/etc/samba/smbpasswd
WORKGROUP=WORKGROUP

# ------------------------------------------------------------
# Безопасность
# ------------------------------------------------------------
# Разрешённые Host-заголовки. * = все (рекомендуется для LAN).
# Или список через запятую: localhost,127.0.0.1,192.168.1.50
ALLOWED_HOSTS=*
# True только если настроен HTTPS (nginx + Let's Encrypt).
# False для прямого доступа по http://IP:5000
SESSION_COOKIE_SECURE=False

# ------------------------------------------------------------
# Логи
# ------------------------------------------------------------
LOG_LEVEL=INFO